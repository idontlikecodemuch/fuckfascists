        "lines": [
          {
            "id": "c60-02-1",
            "text": "Hi. I'm Clark. Your public records clerk. I've organized hundreds of gigabytes of FEC filings, state campaign data and UPC codes."
          },
          {
            "id": "c60-02-2",
            "text": "No accounts. No tracking. Financial contributions, on file."
          },
          {
            "id": "c60-02-3",
            "text": "That card? Here's how it happens."
          }
        ]
      },
      {
        "panel": "03",
        "title": "MAP · SCAN",
        "kind": "feature",
        "feature": "MAP",
        "lines": [
          {
            "id": "c60-03-1",
            "text": "Tap any business near you."
          }
        ]
      },
      {
        "panel": "04",
        "title": "MAP · THE FILE",
        "kind": "feature",
        "feature": "MAP",
        "lines": [
          {
            "id": "c60-04-1",
            "text": "I pull the file. Every dollar. Both parties. Straight from FEC.gov."
          }
        ]
      },
      {
        "panel": "05",
        "title": "MAP · AVOID",
        "kind": "feature",
        "feature": "MAP",
        "lines": [
          {
            "id": "c60-05-1",
            "text": "Don't want to support them? Tap avoid."
          }
        ]
      },
      {
        "panel": "06",
        "title": "TRACK · PICK YOUR PLATFORMS",
        "kind": "feature",
        "feature": "TRACK",
        "lines": [
          {
            "id": "c60-06-1",
            "text": "Pick the platforms you use. I'll log the days you skip them."
          }
        ]
      },
      {
        "panel": "07",
        "title": "TRACK · ALL WEEK",
        "kind": "feature",
        "feature": "TRACK",
        "lines": [
          {
            "id": "c60-07-1",
            "text": "Tap avoid when you skip one. Missed a day? Tap it in."
          }
        ]
      },
      {
        "panel": "08",
        "title": "TRACK · THE ARENA",
        "kind": "feature",
        "feature": "TRACK",
        "lines": [
          {
            "id": "c60-08-1",
            "text": "Every avoid counts toward your scorecard."
          }
        ]
      },
      {
        "panel": "09",
        "title": "SCAN · THE BARCODE",
        "kind": "feature",
        "feature": "SCAN",
        "lines": [
          {
