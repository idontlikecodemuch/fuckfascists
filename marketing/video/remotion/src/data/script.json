            "text": "At the store? Scan a barcode."
          }
        ]
      },
      {
        "panel": "10",
        "title": "SCAN · THE PARENT",
        "kind": "feature",
        "feature": "SCAN",
        "lines": [
          {
            "id": "c60-10-1",
            "text": "I find the parent company. Here's their file."
          }
        ]
      },
      {
        "panel": "11",
        "title": "SCORECARD · INCOMING",
        "kind": "feature",
        "feature": "SCORECARD",
        "lines": [
          {
            "id": "c60-11-1",
            "text": "Random drop between Friday and Saturday."
          }
        ]
      },
      {
        "panel": "12",
        "title": "THE DROP",
        "kind": "drop",
        "lines": [
