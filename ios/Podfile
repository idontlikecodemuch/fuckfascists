require File.join(File.dirname(`node --print "require.resolve('expo/package.json')"`), "scripts/autolinking")
require File.join(File.dirname(`node --print "require.resolve('react-native/package.json')"`), "scripts/react_native_pods")

require 'json'
podfile_properties = JSON.parse(File.read(File.join(__dir__, 'Podfile.properties.json'))) rescue {}

ENV['RCT_NEW_ARCH_ENABLED'] = podfile_properties['newArchEnabled'] == 'true' ? '1' : '0'
ENV['EX_DEV_CLIENT_NETWORK_INSPECTOR'] = podfile_properties['EX_DEV_CLIENT_NETWORK_INSPECTOR']

platform :ios, podfile_properties['ios.deploymentTarget'] || '15.1'
install! 'cocoapods',
  :deterministic_uuids => false

prepare_react_native_project!

target 'FckFascists' do
  use_expo_modules!

  if ENV['EXPO_USE_COMMUNITY_AUTOLINKING'] == '1'
    config_command = ['node', '-e', "process.argv=['', '', 'config'];require('@react-native-community/cli').run()"];
  else
    config_command = [
      'node',
      '--no-warnings',
      '--eval',
      'require(require.resolve(\'expo-modules-autolinking\', { paths: [require.resolve(\'expo/package.json\')] }))(process.argv.slice(1))',
      'react-native-config',
      '--json',
      '--platform',
      'ios'
    ]
  end

  config = use_native_modules!(config_command)

  use_frameworks! :linkage => podfile_properties['ios.useFrameworks'].to_sym if podfile_properties['ios.useFrameworks']
  use_frameworks! :linkage => ENV['USE_FRAMEWORKS'].to_sym if ENV['USE_FRAMEWORKS']

  use_react_native!(
    :path => config[:reactNativePath],
    :hermes_enabled => podfile_properties['expo.jsEngine'] == nil || podfile_properties['expo.jsEngine'] == 'hermes',
    # An absolute path to your application root.
    :app_path => "#{Pod::Config.instance.installation_root}/..",
    :privacy_file_aggregation_enabled => podfile_properties['apple.privacyManifestAggregationEnabled'] != 'false',
  )

  post_install do |installer|
    react_native_post_install(
      installer,
      config[:reactNativePath],
      :mac_catalyst_enabled => false,
      :ccache_enabled => podfile_properties['apple.ccacheEnabled'] == 'true',
    )

    # This is necessary for Xcode 14, because it signs resource bundles by default
    # when building for devices.
    installer.target_installation_results.pod_target_installation_results
      .each do |pod_name, target_installation_result|
      target_installation_result.resource_bundle_targets.each do |resource_bundle_target|
        resource_bundle_target.build_configurations.each do |config|
          config.build_settings['CODE_SIGNING_ALLOWED'] = 'NO'
        end
      end
    end

    # ── Minimum pod deployment target ───────────────────────────────────
    # Xcode 27 rejects targets below iOS 15.0, and some pod resource bundles
    # (react-native-maps' privacy bundle) still declare 11.0. Raise any
    # lower target to the app's own minimum. Idempotent — safe to re-run.
    min_ios = podfile_properties['ios.deploymentTarget'] || '15.1'
    installer.pods_project.targets.each do |target|
      target.build_configurations.each do |build_config|
        current = build_config.build_settings['IPHONEOS_DEPLOYMENT_TARGET']
        if current && Gem::Version.new(current) < Gem::Version.new(min_ios)
          build_config.build_settings['IPHONEOS_DEPLOYMENT_TARGET'] = min_ios
        end
      end
    end

    # ── AIRMap nil guard patch ──────────────────────────────────────────
    # Prevents NSInvalidArgumentException crash when Fabric reconciler
    # passes nil subviews to the native map during rapid marker add/remove.
    # See react-native-maps#5345, #5217. Idempotent — safe to re-run.
    airmap_path = File.join(installer.sandbox.pod_dir('react-native-maps'), 'ios', 'AirMaps', 'AIRMap.m')
    if File.exist?(airmap_path)
      content = File.read(airmap_path)
      unless content.include?('// FCK nil-guard patch')
        patched = content
          .gsub(
            /(-\s*\(void\)insertReactSubview:\(id<RCTComponent>\)subview atIndex:\(NSInteger\)atIndex\s*\{)/,
            "\\1\n  // FCK nil-guard patch — prevents nil subview crash on Fabric\n  if (subview == nil) return;"
          )
          .gsub(
            /(-\s*\(void\)removeReactSubview:\(id<RCTComponent>\)subview\s*\{)/,
            "\\1\n  // FCK nil-guard patch\n  if (subview == nil) return;"
          )
          .gsub(
            /(-\s*\(void\)addSubview:\(UIView\s*\*\)view\s*\{)/,
            "\\1\n  // FCK nil-guard patch\n  if (view == nil) return;"
          )
        if patched != content
          File.write(airmap_path, patched)
          Pod::UI.puts "✅ AIRMap.m patched with nil guards"
        else
          Pod::UI.puts "⚠️  AIRMap.m patch patterns not found — check react-native-maps version"
        end
      else
        Pod::UI.puts "✅ AIRMap.m nil guards already present"
      end
    else
      Pod::UI.puts "⚠️  AIRMap.m not found at #{airmap_path} — skipping nil guard patch"
    end

    # ── expo-camera macro lens patch ────────────────────────────────────
    # expo-camera 16 hardcodes .builtInWideAngleCamera, which on iPhone Pros
    # has a ~10cm minimum focus distance and skips the macro-capable
    # ultra-wide lens. Patch the device selector to prefer the multi-camera
    # virtual devices (.builtInTripleCamera on Pros, .builtInDualWideCamera
    # on recent non-Pros) so iOS auto-switches to ultra-wide for close
    # subjects — critical for barcode scanning of small UPCs at close range.
    # Falls back to .builtInWideAngleCamera for front-facing and older devices.
    # Idempotent — safe to re-run.
    expo_camera_utils_path = File.join(installer.sandbox.pod_dir('ExpoCamera'), 'ios', 'Common', 'ExpoCameraUtils.swift')
    if File.exist?(expo_camera_utils_path)
      content = File.read(expo_camera_utils_path)
      unless content.include?('// FCK macro-lens patch')
        original = "static func device(with mediaType: AVMediaType, preferring position: AVCaptureDevice.Position) -> AVCaptureDevice? {\n    return AVCaptureDevice.default(.builtInWideAngleCamera, for: mediaType, position: position)\n  }"
        replacement = "static func device(with mediaType: AVMediaType, preferring position: AVCaptureDevice.Position) -> AVCaptureDevice? {\n    // FCK macro-lens patch — prefer virtual multi-camera devices on back-facing\n    // so iOS auto-switches to ultra-wide lens for close subjects (~2cm min focus\n    // vs ~10cm on single wide-angle). Critical for close-range barcode scanning.\n    if position == .back {\n      if let triple = AVCaptureDevice.default(.builtInTripleCamera, for: mediaType, position: position) {\n        return triple\n      }\n      if let dualWide = AVCaptureDevice.default(.builtInDualWideCamera, for: mediaType, position: position) {\n        return dualWide\n      }\n    }\n    return AVCaptureDevice.default(.builtInWideAngleCamera, for: mediaType, position: position)\n  }"
        if content.include?(original)
          File.write(expo_camera_utils_path, content.sub(original, replacement))
          Pod::UI.puts "✅ ExpoCameraUtils.swift patched with macro-lens fallback chain"
        else
          Pod::UI.puts "⚠️  ExpoCameraUtils.swift patch pattern not found — check expo-camera version"
        end
      else
        Pod::UI.puts "✅ ExpoCameraUtils.swift macro-lens patch already present"
      end
    else
      Pod::UI.puts "⚠️  ExpoCameraUtils.swift not found at #{expo_camera_utils_path} — skipping macro-lens patch"
    end
  end
end
