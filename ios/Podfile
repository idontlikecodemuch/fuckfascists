require File.join(File.dirname(`node --print "require.resolve('expo/package.json')"`), "scripts/autolinking")
require File.join(File.dirname(`node --print "require.resolve('react-native/package.json')"`), "scripts/react_native_pods")

require 'json'
podfile_properties = JSON.parse(File.read(File.join(__dir__, 'Podfile.properties.json'))) rescue {}

ENV['RCT_NEW_ARCH_ENABLED'] = podfile_properties['newArchEnabled'] == 'true' ? '1' : '0'
ENV['EX_DEV_CLIENT_NETWORK_INSPECTOR'] = podfile_properties['EX_DEV_CLIENT_NETWORK_INSPECTOR']

platform :ios, podfile_properties['ios.deploymentTarget'] || '15.1'
install! 'cocoapods',
  :deterministic_uuids => false

prepare_react_native_project!

target 'FckFascists' do
  use_expo_modules!

  if ENV['EXPO_USE_COMMUNITY_AUTOLINKING'] == '1'
    config_command = ['node', '-e', "process.argv=['', '', 'config'];require('@react-native-community/cli').run()"];
  else
    config_command = [
      'node',
      '--no-warnings',
      '--eval',
      'require(require.resolve(\'expo-modules-autolinking\', { paths: [require.resolve(\'expo/package.json\')] }))(process.argv.slice(1))',
      'react-native-config',
      '--json',
      '--platform',
      'ios'
    ]
  end

  config = use_native_modules!(config_command)

  use_frameworks! :linkage => podfile_properties['ios.useFrameworks'].to_sym if podfile_properties['ios.useFrameworks']
  use_frameworks! :linkage => ENV['USE_FRAMEWORKS'].to_sym if ENV['USE_FRAMEWORKS']

  use_react_native!(
    :path => config[:reactNativePath],
    :hermes_enabled => podfile_properties['expo.jsEngine'] == nil || podfile_properties['expo.jsEngine'] == 'hermes',
    # An absolute path to your application root.
    :app_path => "#{Pod::Config.instance.installation_root}/..",
    :privacy_file_aggregation_enabled => podfile_properties['apple.privacyManifestAggregationEnabled'] != 'false',
  )

  post_install do |installer|
    react_native_post_install(
      installer,
      config[:reactNativePath],
      :mac_catalyst_enabled => false,
      :ccache_enabled => podfile_properties['apple.ccacheEnabled'] == 'true',
    )

    # This is necessary for Xcode 14, because it signs resource bundles by default
    # when building for devices.
    installer.target_installation_results.pod_target_installation_results
      .each do |pod_name, target_installation_result|
      target_installation_result.resource_bundle_targets.each do |resource_bundle_target|
        resource_bundle_target.build_configurations.each do |config|
          config.build_settings['CODE_SIGNING_ALLOWED'] = 'NO'
        end
      end
    end

    # ── RCTViewComponentView layoutMetrics recycle patch ────────────────
    # Backport of facebook/react-native#55796 (lands in RN 0.85.0):
    # "Fix transformOrigin calculating based on incorrect value" and the
    # corresponding _layoutMetrics reset in prepareForRecycle.
    #
    # On RN 0.76.0 + new arch (Fabric), recycled UIViews retain stale
    # _layoutMetrics from their prior occupants. resolveTransform() and
    # downstream layout reads then use wrong frame dimensions, which on
    # iOS shows up as overflow:'hidden' children clipping to a stale
    # smaller frame — the BusinessCard sprite "top of head only" bug we
    # spent the night chasing. Symptoms documented in #48392, #48790,
    # #42732. Idempotent — safe to re-run.
    rct_view_path = File.join(
      __dir__, '..', 'node_modules', 'react-native', 'React', 'Fabric',
      'Mounting', 'ComponentViews', 'View', 'RCTViewComponentView.mm'
    )
    if File.exist?(rct_view_path)
      content = File.read(rct_view_path)
      unless content.include?('// FCK layout-metrics recycle patch')
        patched = content
          # 1. Reset _layoutMetrics in prepareForRecycle so recycled views
          #    don't hand stale frame data to the next occupant.
          .gsub(
            '_reactSubviews = [NSMutableArray new];',
            "_reactSubviews = [NSMutableArray new];\n  // FCK layout-metrics recycle patch — backport of react-native#55796 (RN 0.85.0)\n  _layoutMetrics = {};"
          )
          # 2. Capture previous frame size BEFORE the super-call mutates
          #    _layoutMetrics. The transform recompute condition below
          #    needs the actual previous frame, not the recycled-view
          #    stored value.
          .gsub(
            '[super updateLayoutMetrics:layoutMetrics oldLayoutMetrics:_layoutMetrics];',
            "// FCK layout-metrics recycle patch — capture previous frame before super updates _layoutMetrics\n  auto previousFrameSize = _layoutMetrics.frame.size;\n  [super updateLayoutMetrics:layoutMetrics oldLayoutMetrics:_layoutMetrics];"
          )
          # 3. Use the captured previousFrameSize for the transform
          #    recompute trigger instead of the parameter oldLayoutMetrics
          #    (which is also stale on a recycled view).
          .gsub(
            'layoutMetrics.frame.size != oldLayoutMetrics.frame.size',
            'layoutMetrics.frame.size != previousFrameSize'
          )
        if patched != content
          File.write(rct_view_path, patched)
          Pod::UI.puts "✅ RCTViewComponentView.mm patched (layoutMetrics recycle fix from RN 0.85.0)"
        else
          Pod::UI.puts "⚠️  RCTViewComponentView.mm patch patterns not matched — review RN version"
        end
      else
        Pod::UI.puts "✅ RCTViewComponentView.mm layoutMetrics patch already present"
      end
    else
      Pod::UI.puts "⚠️  RCTViewComponentView.mm not found at #{rct_view_path} — skipping patch"
    end

    # ── AIRMap nil guard patch ──────────────────────────────────────────
    # Prevents NSInvalidArgumentException crash when Fabric reconciler
    # passes nil subviews to the native map during rapid marker add/remove.
    # See react-native-maps#5345, #5217. Idempotent — safe to re-run.
    airmap_path = File.join(installer.sandbox.pod_dir('react-native-maps'), 'ios', 'AirMaps', 'AIRMap.m')
    if File.exist?(airmap_path)
      content = File.read(airmap_path)
      unless content.include?('// FCK nil-guard patch')
        patched = content
          .gsub(
            /(-\s*\(void\)insertReactSubview:\(id<RCTComponent>\)subview atIndex:\(NSInteger\)atIndex\s*\{)/,
            "\\1\n  // FCK nil-guard patch — prevents nil subview crash on Fabric\n  if (subview == nil) return;"
          )
          .gsub(
            /(-\s*\(void\)removeReactSubview:\(id<RCTComponent>\)subview\s*\{)/,
            "\\1\n  // FCK nil-guard patch\n  if (subview == nil) return;"
          )
          .gsub(
            /(-\s*\(void\)addSubview:\(UIView\s*\*\)view\s*\{)/,
            "\\1\n  // FCK nil-guard patch\n  if (view == nil) return;"
          )
        if patched != content
          File.write(airmap_path, patched)
          Pod::UI.puts "✅ AIRMap.m patched with nil guards"
        else
          Pod::UI.puts "⚠️  AIRMap.m patch patterns not found — check react-native-maps version"
        end
      else
        Pod::UI.puts "✅ AIRMap.m nil guards already present"
      end
    else
      Pod::UI.puts "⚠️  AIRMap.m not found at #{airmap_path} — skipping nil guard patch"
    end
  end
end
