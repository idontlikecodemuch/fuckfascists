# OpenFEC API key — free, get yours at https://api.data.gov/signup/
# Rate limit: 1,000 requests / hour with key.
FEC_API_KEY=your_fec_api_key_here

# Legacy: OpenSecrets API key (no longer used — kept for reference)
# OPENSECRETS_API_KEY=your_opensecrets_api_key_here
OPENAI_API_KEY=

# App Store Connect API — TestFlight feedback import
# Generate in App Store Connect > Users and Access > Integrations.
APP_STORE_CONNECT_KEY_ID=
APP_STORE_CONNECT_ISSUER_ID=
APP_STORE_CONNECT_PRIVATE_KEY_PATH=./AuthKey_YOURKEYID.p8
APP_STORE_CONNECT_APP_ID=

# Google Play Developer API — production reviews import.
# Testing feedback for open/closed/internal tracks is Play Console-only in Google's public API.
GOOGLE_PLAY_PACKAGE_NAME=
GOOGLE_PLAY_SERVICE_ACCOUNT_KEY_PATH=./google-play-service-account.json
